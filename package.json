{
  "name": "frame-loom",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Electron 与 React 的多模态 AI 智能影视工作台",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @frame-loom/engine... build && pnpm --filter @frame-loom/desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "deploy:engine": "pnpm --filter @frame-loom/engine... build && pnpm --filter @frame-loom/engine deploy --prod",
    "prepare": "node scripts/setup-git.mjs --hooks-only",
    "setup:git": "node scripts/setup-git.mjs",
    "verify-commit-message": "node scripts/verify-commit-message.mjs",
    "verify-commits": "node scripts/verify-commits.mjs",
    "test:commit-convention": "node --test tests/commit-convention.test.mjs",
    "verify-agent-note-tree": "tsx .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts",
    "verify-agent-note-format": "tsx .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts",
    "verify-archived": "tsx .agents/skills/write-notes-like-deepseek/scripts/verify-archived-agent-notes.ts",
    "verify-notes": "pnpm run verify-agent-note-tree && pnpm run verify-agent-note-format && pnpm run verify-archived",
    "verify-plans": "node .agents/skills/todo-plan/scripts/verify-plans.mjs",
    "test:plans": "node --test tests/plans.test.mjs",
    "verify": "pnpm run verify-notes && pnpm run verify-plans",
    "archive-agent-note": "tsx .agents/skills/write-notes-like-deepseek/scripts/archive-agent-note.ts",
    "check-anchors": "tsx .agents/skills/write-notes-like-deepseek/scripts/check-note-anchors.ts",
    "init-board": "tsx .agents/skills/write-notes-like-deepseek/scripts/build-board.ts --init board.html \"Frame Loom 决策看板\"",
    "bundle-board": "tsx .agents/skills/write-notes-like-deepseek/scripts/build-board.ts --bundle .agents/notes demo.html \"Frame Loom 决策看板\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
