{
  "schema_version": 1,
  "meta_type": "ai-code-events",
  "storage": {
    "root_dir": ".ai-meta",
    "layout": "monthly-directory/daily-jsonl",
    "event_file_prefix": "code-events-",
    "event_file_suffix": ".jsonl"
  },
  "event_schema": {
    "required_fields": [
      "schema_version",
      "event_id",
      "timestamp",
      "tool",
      "author",
      "file_path",
      "change_type",
      "added_lines",
      "deleted_lines",
      "ai_generated_lines",
      "status"
    ]
  }
}
